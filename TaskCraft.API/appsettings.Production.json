{
  "ConnectionStrings": {
    "DefaultConnection": "Server=your-production-server;Database=TaskCraftDb;User Id=your-user;Password=your-password;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE-WITH-PRODUCTION-SECRET-KEY-MINIMUM-32-CHARACTERS",
    "Issuer": "TaskCraftAPI",
    "Audience": "TaskCraftClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://app.taskcraft.com",
      "https://www.taskcraft.com"
    ]
  }
}
